# =============================================================================
# Octane Nexus — environment
#
# Generated from the variables the code actually reads. Copy to .env.local and
# fill in. Anything prefixed NEXT_PUBLIC_ is compiled into the BROWSER bundle —
# never put a secret behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; used by cron + webhooks

# -----------------------------------------------------------------------------
# Models (required — the daily brief does not generate without these)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=                     # server-only. NOT NEXT_PUBLIC_.
OPENAI_API_KEY=                     # TTS, image generation

# -----------------------------------------------------------------------------
# YouTube (required for tracked channels and the daily brief)
#
# Channel reads go through per-user OAuth. Without these three the connect flow
# cannot run and briefs are generated with no channel data.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=          # e.g. https://<host>/api/auth/youtube/callback
YOUTUBE_API_KEY=                    # optional fallback for public channel reads

# -----------------------------------------------------------------------------
# Cron (required in production)
#
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`. If it is unset,
# /api/cron/* refuses to run in production rather than being left open.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Billing (required only if /pricing and checkout are live)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Media
# -----------------------------------------------------------------------------
PEXELS_API_KEY=                     # server-only; stock b-roll
# ENABLE_FFMPEG_RENDER=false        # ffmpeg binaries are unavailable on Vercel
                                    # serverless — leave off unless self-hosting

# -----------------------------------------------------------------------------
# Octane inter-system HMAC (shared with the Engineer hub and sibling spokes)
# -----------------------------------------------------------------------------
OCTANE_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Observability (optional — Sentry is skipped entirely when the DSN is unset)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# -----------------------------------------------------------------------------
# Optional data sources
# -----------------------------------------------------------------------------
# APIFY_TOKEN=
# RAPIDAPI_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-host
# NEXT_PUBLIC_DEMO_MODE=false       # set true by the Playwright e2e run
